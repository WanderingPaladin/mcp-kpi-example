# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://kpi:kpi@localhost:5432/kpi

# LLM — required for the chat UI. Keep this server-side; never put it in the frontend.
# If unset, the API returns a setup error instead of fabricating answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible base URL (leave unset for api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1

# MCP server the chat backend connects to as a client
MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Chat API
CHAT_HOST=127.0.0.1
CHAT_PORT=8000
MAX_TOOL_ROUNDS=6
MAX_TOOL_CALLS=12

# Comma-separated browser origins allowed to call the chat API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
